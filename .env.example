# Copy to .env for `docker compose up`. Never commit .env.

# Secrets (generate with: openssl rand -hex 32)
AUTH_SECRET=change-me
SESSION_SECRET=change-me
POSTGRES_PASSWORD=change-me
CLICKHOUSE_PASSWORD=change-me

# "local" keeps login cookies working over plain http. Use "production" behind TLS only.
NODE_ENV=local
# Public URL used in emails (password reset links).
APP_URL=http://localhost:3000
# Host port for the API/UI.
API_PORT=3000

# Optional: seed admin (defaults to admin@splittytest.com / password), applied by the first migration.
#INIT_USER={"email":"you@example.com","password":"a-strong-password","first_name":"Your","last_name":"Name"}

# Optional: outbound email via Mailgun.
#MAILGUN_API_KEY=
#MAILGUN_DOMAIN=
