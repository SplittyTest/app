.env
api/config/local*
api/config/test*

# Keep host builds out of the image. node_modules from macOS contain native
# binaries (bcrypt, better-sqlite3, duckdb) that won't run in the Linux image.
**/node_modules
**/dist
**/.env
**/.env.*
!**/.env.example
**/.DS_Store
**/*.log
.git
.github
.vscode
docs
coverage
