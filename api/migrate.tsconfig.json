{
  "compilerOptions": {
    "target": "es6",
    "module": "nodenext",
    "baseUrl": ".",
    "rootDir": ".",
    "outDir": "dist",
    "paths": {
      "@/*": [
        "src/*"
      ],
      "@lib/*": [
        "src/lib/*"
      ],
      "@lib/DB": [
        "src/lib/DB"
      ],
      "@types/*": [
        "src/types/*"
      ]
    },
    "moduleResolution": "nodenext",
    "resolveJsonModule": true,
    "declaration": true,
    "declarationMap": true,
    "allowJs": true,
    "checkJs": true,
    "esModuleInterop": true,
    "strict": true,
    "forceConsistentCasingInFileNames": true,
    "noImplicitAny": true,
    "skipLibCheck": true,
    "skipDefaultLibCheck": true
  },
  "include": [
    "src/**/*",
    "src/types/**/*.d.ts",
    "migrate/**/*"
  ],
  "exclude": [
    "node_modules",
    "dist"
  ]
}
