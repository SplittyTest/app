    "typescript": "~5.9"
  },
  "scripts": {
    "migrate": "ts-node -P migrate.tsconfig.json -r tsconfig-paths/register migrate/migrate.ts",
    "migrate:postgres": "MIGRATOR_TYPE=store STORE_TYPE=postgres ts-node -P migrate.tsconfig.json -r tsconfig-paths/register migrate/migrate.ts",
    "migrate:sqlite": "MIGRATOR_TYPE=store STORE_TYPE=sqlite ts-node -P migrate.tsconfig.json -r tsconfig-paths/register migrate/migrate.ts",
    "migrate:clickhouse": "MIGRATOR_TYPE=olap METRICS_TYPE=clickhouse ts-node -P migrate.tsconfig.json -r tsconfig-paths/register migrate/migrate.ts",
    "migrate:duckdb": "MIGRATOR_TYPE=olap METRICS_TYPE=duckdb ts-node -P migrate.tsconfig.json -r tsconfig-paths/register migrate/migrate.ts",
    "setup:clickhouse": "ALLOW_CONFIG_MUTATIONS=yes ts-node -r tsconfig-paths/register src/setup.ts",
    "build": "tsc -p tsconfig.json && tsc-alias -p tsconfig.json",
    "build:watch": "tsc -w -p tsconfig.json",
    "build:release": "npm run clean && tsc -p tsconfig.release.json",
    "clean": "rimraf dist tmp",
    "dev": "NODE_ENV=dev tsx watch src/server.ts | bunyan -o short",
    "lint": "eslint src --ext .ts --ext .mts",
    "prebuild": "npm run clean && npm run lint",
    "prettier": "prettier --config .prettierrc --write .",
    "test": "jest --runInBand test",
    "test:watch": "jest --watch"
  },
  "author": "Jakub Synowiec <jsynowiec@users.noreply.github.com>",
